{
  "name": "dsh-open-in-app-base",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：Session header 的 \"Open In...\" 按钮组底座，提供注册契约供同类插件补充目标软件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovezi0/dsh-open-in-app-base.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "open-in-app"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "selftest": "node tests/host-selftest.mjs && node tests/client-selftest.mjs",
    "prepublishOnly": "npm run build"
  }
}
